# Copy to .env.local (git-ignored) and fill in. `npm run setup` does this for you.

# ---- App ----
APP_PASSCODE=              # empty = open locally; set a value to require a passcode
DATABASE_PATH=./data/mission-seek.db

# ---- LLM (bring your own key — stored locally, never committed) ----
LLM_PROVIDER=anthropic     # anthropic | openai | ollama
LLM_REDACT=0               # 1 = redact before sending to a cloud API (placeholder)

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OPENAI_* also drives DeepSeek / Kimi / GLM — just change OPENAI_BASE_URL + OPENAI_MODEL
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Session-signing key (empty = login disabled; `npm run setup` generates one).
AUTH_SECRET=
# DATABASE_PATH override (desktop build points this at the per-user data dir automatically):
# DATABASE_PATH=./data/mission-seek.db

# In-app "feedback" link target (optional). Defaults to this repo's GitHub Issues.
NEXT_PUBLIC_FEEDBACK_URL=
